# WDash lab environment.
# docker compose reads this file automatically.

# --- Elasticsearch ---
ES_VERSION=8.19.9
ES_PORT=9200
ES_HEAP=1g
# The lab runs with security disabled for fast iteration.
# The Advisor should report this as a finding — it is left on purpose.
ES_SECURITY=false

# --- Kibana (profile: kibana) ---
KIBANA_VERSION=8.19.9
KIBANA_PORT=5601

# --- Second Elasticsearch node (profile: cluster) ---
ES2_HEAP=1g

# --- OpenTelemetry Collector (profile: otel) ---
# contrib, not core: the Elasticsearch exporter only ships in contrib.
OTEL_VERSION=0.109.0
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# --- Grafana Loki (profile: loki) ---
LOKI_VERSION=3.1.1
LOKI_PORT=3100

# VictoriaLogs. Pinned, like everything else here: a lab that
# drifts is a lab that stops reproducing the thing it proved.
VICTORIALOGS_VERSION=v1.9.1-victorialogs
VICTORIALOGS_PORT=9428

# Jaeger. v2 is the OpenTelemetry Collector wearing a Jaeger badge:
# same OTLP receivers, Jaeger's own query API on top.
JAEGER_VERSION=2.3.0
JAEGER_PORT=16686
JAEGER_OTLP_PORT=4319

# Grafana Tempo. AGPLv3, like Loki — which binds the server, not an
# HTTP client of it, so WDash speaking to it changes nothing.
TEMPO_VERSION=2.6.1
TEMPO_PORT=3200
TEMPO_OTLP_PORT=4320

# Elastic Heartbeat and the endpoints it probes (profile: synthetics).
# Pinned to the Elasticsearch version — Beats and the stack move together.
HEARTBEAT_VERSION=8.19.9
NGINX_VERSION=1.27-alpine

# --- Identity: a directory and an OIDC provider ---
#
# OpenLDAP 1.5.0 is the osixia image, which has not moved since 2021. It is
# pinned deliberately: it is real OpenLDAP with the overlays this lab needs,
# and the alternative that was maintained — bitnami/openldap — has since had
# its tags withdrawn to a `bitnamilegacy` namespace, which is a worse thing
# for a lab to depend on than an image that stopped changing.
OPENLDAP_VERSION=1.5.0
LDAP_PORT=1389
LDAPS_PORT=1636
DEX_VERSION=v2.41.1
DEX_PORT=5556

