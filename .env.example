# Flask Configuration
#
# Signs every session cookie, the administrator's included. Empty on purpose:
# a value printed here is a value everybody has read, and this file is copied
# into .env by the quick start. Empty, WDash runs on its development key and
# says so; with SESSION_COOKIE_SECURE=true it refuses to start. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# FLASK_DEBUG=true   # Flask debugger and reloader; never in production

# --- Metadata store: WDash's own state, NOT a data source ---
# postgresql://user:pass@host/wdash   for more than one worker
# sqlite:///data/wdash.db             single node and the lab
# DATABASE_URL=sqlite:///data/wdash.db

# Encrypts secrets held in that store (OIDC client secret, LDAP bind password,
# source credentials, and every local account's authenticator). Without it
# those cannot be saved at all — WDash refuses rather than writing them as
# text — and NO LOCAL ACCOUNT CAN SIGN IN, because the second factor every one
# of them needs has nowhere safe to live. Set it before first-run setup.
# Keep it: everything sealed with it needs the same key to be read back, and a
# key that is lost means re-entering every credential and resetting every
# authenticator (python -m wdash.store.recover --reset-totp <username>).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WDASH_ENCRYPTION_KEY=

# Where dashboards live — and saved searches with them, one setting for both:
# database (default) | file.
# An installation upgrading from the JSON files runs
# `python -m wdash.store.migrate_cli` once; until it does, WDash names both
# files and this command at start-up, and nothing is deleted.
# `file` is still supported, for one worker.
# DASHBOARD_STORAGE=database
# The Elasticsearch dashboard store has been removed. This name is now only
# used to keep a leftover index out of log search.
# DASHBOARD_INDEX=wdash-dashboards

# Which indices hold traces. Excluded from log search, or spans come back as
# records with no body and no severity.
# TRACE_INDEX_PATTERNS=*traces*,*apm*

# Elasticsearch Configuration
#
# This registers a source of its own, named "elasticsearch". It predates the
# configuration page and is the quickest way to get one cluster working
# without one.
#
# If you also declare that SAME cluster on the configuration page, both
# register and a merged search counts every matching record twice — the only
# symptom is a total that quietly looks bigger. WDash warns on the
# configuration page when it sees this. Pick one: either leave this empty and
# manage every source on the page, or keep it and do not add the cluster
# there.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password
# ELASTICSEARCH_TIMEOUT=30

# OIDC Configuration
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_DISCOVERY_URL=https://your-oidc-provider.com/.well-known/openid_configuration
OIDC_REDIRECT_URI=http://127.0.0.1:5001/auth/callback
# Which claims name a person; blank uses rbac.yaml's claim_mappings.
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_EMAIL_CLAIM=email
# OIDC_GROUPS_CLAIM=groups
# An email counts only when the provider marks it verified. Set to true only
# for a provider that never sends email_verified and lets nobody edit it.
# OIDC_TRUST_UNVERIFIED_EMAIL=false


# RBAC Configuration
RBAC_CONFIG_FILE=config/rbac.yaml

# Application Settings
LOGS_PER_PAGE=50
MAX_SEARCH_RESULTS=1000
DASHBOARD_STORAGE_FILE=data/dashboards.json

# Security. Set this and serve over HTTPS in production.
# SESSION_COOKIE_SECURE=true

# TLS verification for the cluster above. Off by default so an upgrade never
# takes somebody's cluster away; turn it on for anything but a loopback
# address, and point ELASTICSEARCH_CA_CERTS at your bundle if the certificate
# comes from a private authority.
ELASTICSEARCH_VERIFY_CERTS=false
# ELASTICSEARCH_CA_CERTS=/etc/ssl/certs/internal-ca.pem
