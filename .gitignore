# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/

# Environment files — NEVER COMMIT SECRETS
#
# Deny by default. `.env` alone missed `.env.lab`, which held a real
# WDASH_ENCRYPTION_KEY — and the database holding what that key encrypts was
# not ignored either, so the key and the ciphertext would have been committed
# together.
.env*
!.env.example
!lab/.env

# Runtime data.
#
# `data/*.json` missed data/wdash.db — the metadata database, holding local
# accounts with their password hashes, the audit trail and the encrypted
# source credentials. It also missed every backup, because none of
# `dashboards.json.yedek`, `wdash.db-wal` or `wdash.db.goc-oncesi-…` ends in
# `.json`. Ignore the directory and name the exceptions.
data/*
!data/.gitkeep

# Front-end tooling (dev only; the app ships the committed wdash.min.js)
node_modules/

# The agent's spool: results it has not delivered yet. Written to the working
# directory by default, so running the agent from a checkout drops it here —
# and it holds every URL and hostname the agent probes.
agent-spool.jsonl
*.spool.jsonl

# Lab TLS certificates. Generated by lab/synthetics/make-certs.sh, which
# lab.sh runs — a repository carrying `-----BEGIN PRIVATE KEY-----` teaches
# whoever reads it that this is normal, and every secret scanner flags the
# clone. Worthless keys, but the habit is not.
lab/synthetics/certs/*
!lab/synthetics/certs/README.md
!lab/synthetics/certs/make-certs.sh

# Editor and IDE tooling.
#
# Personal to whoever is working on the checkout, and nothing in the project
# reads them: .kiro/hooks minifies wdash.js on save, which `npm run build`
# also does, and .vscode/settings.json is empty.
.DS_Store
*.swp
.vscode/
.kiro/
.idea/
